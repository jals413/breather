# Generated by scripts/update-cask.sh — edit the template in the Breather repo, not the tap.
cask "breather" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/jals413/breather/releases/download/v#{version}/Breather-#{version}.zip"
  name "Breather"
  desc "Break reminders that live in your MacBook's notch"
  homepage "https://jals413.github.io/breather/"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :tahoe

  app "Breather.app"

  # Breather is open source but not notarized (that needs a paid Apple Developer account).
  # Clear the download quarantine so macOS opens it without the "can't be verified" prompt.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Breather.app"]
  end

  uninstall quit: "com.jalthakor.breather"

  zap trash: [
    "~/Library/Application Support/Breather",
    "~/Library/Preferences/com.jalthakor.breather.plist",
  ]
end
